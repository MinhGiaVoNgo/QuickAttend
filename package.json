{
  "name": "quickattend",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:mobile": "npm run start --workspace=@quickattend/mobile",
    "dev:api": "npm run dev --workspace=@quickattend/api",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:mobile\"",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
